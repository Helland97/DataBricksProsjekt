# Copy to .dlt/secrets.toml (gitignored) and fill in. Values come from infra/02-databricks:
#   terraform output workspace_url            -> server_hostname (without https://)
#   terraform output sql_warehouse_http_path  -> http_path

[destination.databricks.credentials]
server_hostname = "adb-<workspace-id>.<n>.azuredatabricks.net"
http_path       = "/sql/1.0/warehouses/<warehouse-id>"

# Authentication. Leave all three out to use your `az login`: pipelines/databricks_setup.py then points the
# Databricks SDK at server_hostname with auth_type azure-cli (dlt's unified-auth fallback).
# Otherwise pick ONE of:
# access_token  = "dapi..."                  # personal access token (quick, but a long-lived secret)
# client_id     = "<service principal application id>"   # OAuth M2M, what CI/prod should use
# client_secret = "<service principal OAuth secret>"
